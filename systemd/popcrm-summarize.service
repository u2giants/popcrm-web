[Unit]
Description=POP CRM opportunity summary refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ai
WorkingDirectory=/worksp/popcrm-web
EnvironmentFile=/home/ai/.crm-worker.env
TimeoutStartSec=30min
ExecStart=/usr/bin/node /worksp/popcrm-web/workers/crm-worker-supabase.mjs summarize
# Hardening proposal (popcrm-web issue #72). In-repo proposal only — units are
# installed/reloaded by the host owner (docs/deployment.md), never from here.
# summarize writes nothing outside /tmp (Supabase only), so no ReadWritePaths.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
